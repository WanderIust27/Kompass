# Kompass — Einstellungen. Einmal kopieren:  cp .env.example .env
# Diese Datei wird bei einem Update NICHT ueberschrieben.

# ------------------------------------------------------------------ Betrieb
# Unter welchem Port die Oberflaeche erreichbar ist. PULS liegt auf 1337.
KOMPASS_PORT=1338
TZ=Europe/Berlin

# ---------------------------------------------------------------------- KI
# Kompass benutzt das Ollama, das schon fuer PULS laeuft. Wenn du einen
# eigenen Ollama-Container willst, hier dessen Adresse eintragen.
OLLAMA_URL=http://puls-ollama:11434
OLLAMA_MODEL=qwen3:8b
# Fuer die semantische Notizsuche. Leer lassen schaltet sie ab.
EMBED_MODEL=nomic-embed-text

# ------------------------------------------------------------------ Zugang
# Leer = offen im Heimnetz (wie PULS). Wenn du die App nach draussen stellst,
# hier ein langes zufaelliges Wort eintragen — dann fragt Kompass danach.
KOMPASS_TOKEN=

# --------------------------------------------------------------- Internet
# 1 = Kompass darf Preise und Testberichte nachschlagen (nur der Suchbegriff
# verlaesst den Server, nie deine Notizen). 0 = komplett offline.
ALLOW_WEB=1
# Optional: eigene SearXNG-Instanz, sonst wird DuckDuckGo benutzt.
SEARXNG_URL=
# Optional: kostenloser Schluessel von themoviedb.org fuer Film- und Seriendaten.
TMDB_API_KEY=
